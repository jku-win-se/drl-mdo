<?xml version="1.0" encoding="UTF-8"?>
<PacmanGame:Game
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:PacmanGame="http://www.geodes.org/Pacman">
  <gridnodes
      Bottom="//@gridnodes.3"
      Right="//@gridnodes.1"
      Id="0_0"/>
  <gridnodes
      Bottom="//@gridnodes.4"
      Left="//@gridnodes.0"
      Right="//@gridnodes.2"
      Id="0_1"/>
  <gridnodes
      Bottom="//@gridnodes.5"
      Left="//@gridnodes.1"
      Id="0_2"/>
  <gridnodes
      Top="//@gridnodes.0"
      Bottom="//@gridnodes.6"
      Right="//@gridnodes.4"
      Id="1_0"/>
  <gridnodes
      Top="//@gridnodes.1"
      Bottom="//@gridnodes.7"
      Left="//@gridnodes.3"
      Right="//@gridnodes.5"
      Id="1_1"/>
  <gridnodes
      Top="//@gridnodes.2"
      Bottom="//@gridnodes.8"
      Left="//@gridnodes.4"
      Id="1_2"/>
  <gridnodes
      Top="//@gridnodes.3"
      Right="//@gridnodes.7"
      Id="2_0"/>
  <gridnodes
      Top="//@gridnodes.4"
      Left="//@gridnodes.6"
      Right="//@gridnodes.8"
      Id="2_1"/>
  <gridnodes
      Top="//@gridnodes.5"
      Left="//@gridnodes.7"
      Id="2_2"/>
  <scoreboard/>
  <entites xsi:type="PacmanGame:Pacman"
      On="//@gridnodes.7"
      Id="p1"/>
  <entites xsi:type="PacmanGame:Ghost"
      On="//@gridnodes.4"
      Id="g1"/>
  <entites xsi:type="PacmanGame:Ghost"
      On="//@gridnodes.6"
      Id="g2"/>
  <entites xsi:type="PacmanGame:Food"
      On="//@gridnodes.8"
      Id="f1"/>
  <entites xsi:type="PacmanGame:Food"
      On="//@gridnodes.5"
      Id="f2"/>
  <entites xsi:type="PacmanGame:Food"
      On="//@gridnodes.2"
      Id="f3"/>
  <entites xsi:type="PacmanGame:Food"
      On="//@gridnodes.1"
      Id="f4"/>
  <entites xsi:type="PacmanGame:Food"
      On="//@gridnodes.0"
      Id="f5"/>
  <entites xsi:type="PacmanGame:Food"
      On="//@gridnodes.3"
      Id="f6"/>
</PacmanGame:Game>
